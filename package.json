{
  "name": "pm-web",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/licenses.mjs && tsc -b && vite build && node scripts/csp.mjs dist/index.html",
    "build:portable": "node scripts/licenses.mjs && tsc -b && cross-env BUILD_TARGET=portable vite build --outDir dist-portable && node scripts/csp.mjs dist-portable/index.html",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest run",
    "licenses": "node scripts/licenses.mjs",
    "e2e": "node tests/e2e/smoke.mjs && node tests/e2e/planning.mjs && node tests/e2e/governance.mjs && node tests/e2e/file-sync.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@tanstack/react-table": "^8.21.3",
    "browser-fs-access": "^0.38.0",
    "frappe-gantt": "^1.2.2",
    "idb-keyval": "^6.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4.6.7",
    "zundo": "^2.3.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "cross-env": "^10.1.0",
    "eslint": "^8.57.1",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.16",
    "fake-indexeddb": "^6.2.6",
    "playwright": "^1.56.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "3.2"
  }
}
